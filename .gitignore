# dependencies
/node_modules/
/scripts/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/outputs/
/.qa-prospecting-workbook/
/.qa-*/

# generated product assets are too heavy for Vercel static deployment
/public/product-images/
/public/product-documents/

# local lead research database
/data/lead-research/

# local-only product asset archive used for repair/import workflows
/data/product-assets-local/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
