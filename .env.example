NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
# ZES AI remains deterministic/mock-safe unless server-side AI is explicitly enabled.
# Never expose OPENAI_API_KEY to the client and never commit real secrets.
ZES_AI_ENABLED=false
ZES_AI_MODEL=gpt-5.4
ZES_AI_REQUEST_TIMEOUT_MS=12000
OPENAI_API_KEY=
LEAD_INTEGRATION_MODE=mock
CRM_PROVIDER=
CRM_API_KEY=
CRM_WEBHOOK_URL=
# EMAIL_PROVIDER=mock is the safe default. EMAIL_PROVIDER=resend requires LEAD_INTEGRATION_MODE=email-only or email-and-sheets plus server env vars.
# Never commit real email secrets.
EMAIL_PROVIDER=mock
EMAIL_FROM=
EMAIL_API_KEY=
# Internal lead notifications only. Use office@zescorp.ro in production.
LEAD_NOTIFICATION_EMAIL=
LEAD_CONFIRMATION_EMAIL_ENABLED=false
HIGH_PRIORITY_ALERT_EMAIL_ENABLED=false
LEAD_SUBMISSION_COOLDOWN_SECONDS=45
RESEND_API_KEY=
RESEND_VERIFIED_DOMAIN=
RESEND_DOMAIN_VERIFIED=false
RESEND_REQUEST_TIMEOUT_MS=8000
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LEAD_STORAGE_PROVIDER=mock
LEAD_DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PROJECT_ID=
# Preserve newlines in Vercel or use escaped \n sequences.
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_TAB_NAME=Leads
GOOGLE_SHEETS_REQUEST_TIMEOUT_MS=10000
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AUTH_PROVIDER=
AUTH_SECRET=
ADMIN_EMAILS=
# Simple temporary admin gate. Use a strong password in Vercel; never commit real values.
ADMIN_ACCESS_ENABLED=false
ADMIN_ACCESS_PASSWORD=
ADMIN_ACCESS_TTL_SECONDS=28800
NEXTAUTH_URL=
NEXTAUTH_SECRET=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Phase 82A autonomous lead discovery. Server/local scripts only; never expose keys client-side.
# Google Custom Search JSON API: https://developers.google.com/custom-search/v1/overview
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
# Google Places Text Search (Legacy): https://developers.google.com/maps/documentation/places/web-service/legacy/search-text
GOOGLE_PLACES_API_KEY=
# Microsoft retired Bing Search APIs on 2025-08-11. Configure only an approved compatible endpoint.
BING_SEARCH_ENDPOINT=
BING_SEARCH_API_KEY=
